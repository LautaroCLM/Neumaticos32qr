# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO: Neumáticos el 32
# ==============================================================================
# Copiá este archivo como `.env.local` para desarrollo local, o configuralo en el panel
# de Vercel (Settings -> Environment Variables) para el despliegue en producción.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (URL del Proyecto y Llaves de API)
# ------------------------------------------------------------------------------
# En Desarrollo Local:
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:53321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
#
# En Producción (Vercel):
# Obtené estos valores en tu dashboard de Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-privada-aqui

# ------------------------------------------------------------------------------
# 2. Dominio y URL Base de la Aplicación
# ------------------------------------------------------------------------------
# En Desarrollo Local:
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
#
# En Producción: Debe usar HTTPS y ser el dominio real de la aplicación
# (los códigos QR impresos usarán esta URL para redirigir a los clientes).
NEXT_PUBLIC_SITE_URL=https://tu-dominio-o-app.vercel.app

# ------------------------------------------------------------------------------
# 3. Credenciales para Pruebas Locales (SOLO DESARROLLO LOCAL)
# ------------------------------------------------------------------------------
# Utilizadas únicamente por el script `scripts/setup-local-users.ts` al inicializar
# usuarios en la instancia local de Supabase. NO son necesarias en Vercel.
LOCAL_ADMIN_PASSWORD=TuPasswordAdminLocalSeguro123!
LOCAL_OPERARIO_PASSWORD=TuPasswordOperarioLocalSeguro123!
